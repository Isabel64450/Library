{% extends 'base.html.twig' %}

{% block title %}User list{% endblock %}

{% block body %}
<div class="container mt-5">
       <div class="card shadow">
              <div class="card-body">
                     <h1>User List</h1>

                     <table class="table">
                     <thead>
                <tr>
              
                <th>Name</th>
                <th>Email</th>
                <th>Telephone</th>
                <th>Roles</th>
               
                <th>actions</th>
                </tr>
                </thead>
        <tbody>
        {% for user in users %}
            <tr>
                
                <td>{{ user.name }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.telephone }}</td>
                <td>{% if ('ROLE_ADMIN' in user.roles) %}
                        <span class="text-primary">Administrateur</span>                     
                    {% else %}
                         <span class="text-secondary">Client</span> 
                    {% endif %}</td>
                
                <td>
                    <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-outline-primary">show</a>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-outline-primary">edit</a>
                    <a onclick= "return confirm('Voulez vous vraiment supprimer cet utilisateur ?')" href="{{ path('app_user_delete', {'id':user.id}) }}" class="btn btn-danger">delete</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {# <a href="{{ path('app_user_new') }}" class="btn btn-outline-primary">Create new</a> #}

              </div>
       </div>
</div>
   
{% endblock %}
