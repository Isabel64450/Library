{% extends 'base.html.twig' %}

{% block title %}Book{% endblock %}

{% block body %}
   <div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow p-4">
                <h1 class="mb-4 text-center">Book Details</h1>
               <div class="text-center mb-4">
                  {% if book.Image %}
               <img src="{{ asset('uploads/images/'~ book.Image) }}" 
                 alt="Couverture de {{ book.title }}" 
                 class="img-fluid rounded shadow" 
                 style="max-height: 300px;">
                {% else %}
             <p>Aucune couverture disponible</p>
                   {% endif %}
              </div>
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th scope="row">Id</th>
                            <td>{{ book.id }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Title</th>
                            <td>{{ book.title }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Author</th>
                            <td>{{ book.author }}</td>
                        </tr>
                        <tr>
                            <th scope="row">ISBN</th>
                            <td>{{ book.isbn }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Stock</th>
                            <td>{{ book.stock }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Description</th>
                             <td>{{ book.description ?: 'Pas de description disponible.' }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="d-flex justify-content-end mt-3">
                    <a class="btn btn-sm btn-outline-secondary me-2" href="{{ path('app_book_index') }}">
                    <i class="bi bi-arrow-left"></i> Back
                    </a>
                    {% if is_granted("ROLE_ADMIN") %}
                    <a class="btn btn-sm btn-warning me-2" href="{{ path('app_book_edit', {'id': book.id}) }}">
                    <i class="bi bi-pencil"></i> Edit
                    </a>
                    {{ include('book/_delete_form.html.twig') }}
                     {% endif %}
                </div>

            </div>

        </div>
    </div>
</div>
{% endblock %}
