{% extends 'base.html.twig' %}

{% block title %}Book index{% endblock %}

{% block body %}
    <div class="container mt-5">

    <div class="card shadow">
        <div class="card-body">
            <h1 class="mb-4 text-center">Books catalogue</h1>
             {% include 'layouts/_flash_message.html.twig' %}
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        
                        <th scope="col">Title</th>
                        <th scope="col">Author</th>
                        <th scope="col">ISBN</th>
                        <th scope="col">Stock</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for book in books %}
                    <tr>
                        
                        <td>{{ book.title }}</td>
                        <td>{{ book.author }}</td>
                        <td>{{ book.isbn }}</td>
                        <td> {% if book.stock > 0  %}
                        {{ book.stock }}
                        
                    {% else %}
                        <span class="text-danger">Stock épuisé</span>
                    {% endif %}
                        </td>
                        <td>
                            <a class="btn btn-sm btn-info" href="{{ path('app_book_show', {'id': book.id}) }}">Show</a>
                             {% if is_granted('ROLE_ADMIN') %}
                            <a class="btn btn-sm btn-warning" href="{{ path('app_book_edit', {'id': book.id}) }}">Edit</a>
                             {% endif %}
                              {% if is_granted('ROLE_USER') %}
      
                            <a class="btn btn-sm btn-success" href="{{ path('app_loan_new', {'id': book.id}) }}">Loan</a>
                            {% else %}
                            <a class="btn btn-sm btn-primary" href="{{ path('app_login') }}">Loan?</a>
                            
                            {% endif %}
                           
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center">No records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <div class="text-center mt-3">
                 {% if is_granted('ROLE_ADMIN') %}
                <a class="btn btn-primary" href="{{ path('app_book_new') }}">Create New Book</a>
                {% endif %}
            </div>
        </div>
    </div>

</div>
{% endblock %}
