{% extends 'base.html.twig' %}

{% block title %}Current Loans {% endblock %}

{% block body %}
<div class="container mt-5">

   
    <div class="card shadow">

        <div class="card-body">
             <h1>Loans list</h1>
             {% include 'layouts/_flash_message.html.twig' %}
            <table class="table table-hover table-striped align-middle">

                <thead class="table-dark">
                    <tr>
                        
                        <th>Book</th>
                        <th>User</th>
                        <th>Loan Date</th>
                        <th>Return Date</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                {% for loan in loans| slice(0,10) %}

                    <tr>
                       

                        <td>{{ loan.book.title }}</td>

                        <td>{{ loan.user.name }}</td>

                        <td>
                            {{ loan.loanDate ? loan.loanDate|date('Y-m-d') : '' }}
                        </td>

                        <td>
                            {{ loan.returnDate ? loan.returnDate|date('Y-m-d') : '' }}
                        </td>

                        <td>
                            {% if loan.status == 'current' %}
                                <span class="badge bg-primary">Current</span>
                            {% elseif loan.status == 'delayed' %}
                                <span class="badge bg-danger">Delayed</span>
                            {% elseif loan.status == 'completed' %}
                                <span class="badge bg-success">Completed</span>
                            {% endif %}
                        </td>

                        <td class="text-center">

                            <a href=" {{ path('app_loan_show', {'id': loan.id}) }} " 
                               class="btn btn-sm btn-info">
                                Detail
                            </a>

                            <a href="{{ path('app_loan_edit', {'id': loan.id}) }} " 
                               class="btn btn-sm btn-warning">
                                Rendre
                            </a>

                              
                        </td>

                    </tr>

                {% else %}

                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Aucun loan trouvé
                        </td>
                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>
{% endblock %}
