{% extends 'base.html.twig' %}

{% block title %}Détail de l'emprunt{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow col-md-8 col-lg-6 mx-auto p-4">

        <h2 class="mb-3">Emprunt - {{ loan.book.title }}</h2>

        <ul class="list-group list-group-flush">
            <li class="list-group-item"><strong>Utilisateur :</strong> {{ loan.user.name }} - {{ loan.user.email }} - {{ loan.user.telephone }}</li>
            <li class="list-group-item"><strong>Date emprunt :</strong> {{ loan.loanDate|date('d/m/Y') }}</li>
            <li class="list-group-item"><strong>Date retour :</strong> {{ loan.returnDate|date('d/m/Y') }}</li>
            <li class="list-group-item"><strong>Status :</strong> {{ loan.status|capitalize }}</li>
        </ul>

        <div class="mt-3 text-center">
            <a href="{{ path('app_loan_list') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>

    </div>
</div>
{% endblock %}